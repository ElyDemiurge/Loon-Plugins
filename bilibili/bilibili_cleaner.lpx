#!name=比狸比狸过滤
#!desc=本插件支持 iOS 与 iPadOS，覆盖开屏、首页热门、首页推荐页、首页搜索页面、搜索结果、搜索候选词条、动态页、视频详情页、视频页推荐流、评论区、直播间及「我的」页面，并过滤 iPadOS 大会员广告素材；可按标题、UP 主、视频 Tag、动态内容、搜索结果内容和搜索候选词条过滤，同时移除广告、直播推荐、青少年模式弹窗与交互式弹幕，并拦截数据上报与追踪。\n\n注：\n本插件可能与其他 Bilibili 插件冲突。\n如需排查插件的功能是否正常，请开启对应功能的弹窗通知。通知触发时也会同步写入脚本运行日志。\n需 Loon 3.4.0 及以上版本，并启用 MitM-over-HTTP/2。
#!author=Cyberangel、Codex[https://github.com/ElyDemiurge]
#!homepage=https://github.com/ElyDemiurge/Loon-Plugins/tree/main/bilibili
#!tag=bilibili,去广告
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!date=2026-07-26

[Argument]
blockedUps=input, "", tag=屏蔽-UP 主（名称）, desc=多个 UP 主名称用逗号、竖线、分号或换行分隔。UP 主名称必须完全匹配才会屏蔽
titleKeywords=input, "", tag=屏蔽-视频（关键词）, desc=多个关键词用逗号、竖线、分号或换行分隔；标题只要包含任一关键词就会屏蔽，例如：关键词A,关键词B|关键词C
dynamicKeywords=input, "", tag=屏蔽-关注页动态（关键词）, desc=多个关键词用逗号、竖线、分号或换行分隔；动态内容包含任一关键词时移除整条动态
searchResultKeywords=input, "", tag=屏蔽-搜索结果与候选词条（关键词）, desc=多个关键词用逗号、竖线、分号或换行分隔；搜索结果与搜索候选词条包含任一关键词时移除
deepFilter=switch, false, true, tag=屏蔽-深度屏蔽（并发，更耗流量）, desc=开启后会记录视频详情接口中的 Tag，并在首页热门、首页推荐页、视频页推荐流和搜索结果普通视频中按视频 Tag 屏蔽
videoTagKeywords=input, "", tag=深度屏蔽-视频 Tag（可正则）, desc=开启深度屏蔽后生效。多个正则用逗号、分号或换行分隔；任一正则匹配到视频 Tag 就会屏蔽，例如：^测试Tag$
cleanSplashAds=switch, true, false, tag=移除-开屏广告, desc=开启后清空开屏广告展示列表和素材缓存
cleanLiveAds=switch, true, false, tag=移除-直播页面的广告, desc=开启后移除直播间信息流与房间页的广告卡片
cleanTeenagersMode=switch, true, false, tag=移除-青少年模式弹窗, desc=开启后关闭青少年模式弹窗
cleanStartupAds=switch, true, false, tag=移除-软件启动时加载的推广, desc=开启后清理 iOS 与 iPadOS 的启动活动 Tab、启动皮肤和开屏预加载推广资源，并清空 iPadOS 大会员广告素材与登录优惠浮层
cleanFeedAds=switch, true, false, tag=移除-首页推荐页的广告, desc=开启后首页推荐页会移除 Banner、非视频广告和非普通视频卡片
cleanFeedPromotedVideos=switch, true, false, tag=移除-首页推荐页的推广视频, desc=开启后首页推荐页会移除带广告标记的视频推广卡片
cleanSearchDefaultWords=switch, true, false, tag=移除-首页搜索框的推荐词, desc=开启后移除首页搜索框内滚动展示的默认推荐词
cleanSearchTrending=switch, true, false, tag=移除-首页搜索页的热搜, desc=开启后移除首页搜索页面中的 bilibili 热搜模块
cleanSearchHistory=switch, true, false, tag=移除-首页搜索页的搜索历史, desc=开启后移除首页搜索页面中的搜索历史模块
cleanSearchResultLiveRooms=switch, true, false, tag=移除-首页搜索结果的直播, desc=开启后移除搜索结果中的直播间卡片
cleanSearchResultAds=switch, true, false, tag=移除-首页搜索结果的广告, desc=开启后移除搜索结果中的广告卡片
cleanSearchDiscovery=switch, true, false, tag=移除-首页搜索结果的搜索发现, desc=开启后移除首页搜索页面中的搜索发现模块
cleanSearchResultCreatorPromotions=switch, true, false, tag=移除-首页搜索结果的创作推广, desc=开启后移除搜索结果中的创作推广卡片
cleanSearchResultAggregationCards=switch, true, false, tag=移除-首页搜索结果的聚合卡片, desc=开启后移除搜索结果中的百科、官方入口等聚合卡片
cleanVideoRelatedPromotedContent=switch, true, false, tag=移除-视频页推荐流的推广内容, desc=开启后移除视频详情页推荐流中的商业推广内容
cleanVideoRelatedAds=switch, true, false, tag=移除-视频页推荐流的广告卡片, desc=开启后移除视频详情页推荐流中的普通广告卡片
cleanVideoRelatedLiveRecommendations=switch, true, false, tag=移除-视频页推荐流的直播卡片, desc=开启后移除视频详情页推荐流中的直播推荐卡片
cleanVideoBannerAds=switch, true, false, tag=移除-视频页视频下方的横幅广告, desc=开启后移除视频详情页中的横幅下载广告
cleanInteractiveDanmaku=switch, true, false, tag=移除-视频页播放时的交互式弹幕, desc=开启后移除视频交互式弹幕
cleanVideoUpGoodsAds=switch, true, false, tag=移除-视频页 UP 主推荐好物, desc=开启后移除视频详情页下方的 UP 主推荐好物商品广告
cleanReplyTopAds=switch, true, false, tag=移除-视频页评论区的置顶广告, desc=开启后移除评论区置顶的广告回复
cleanDynamicUpRecommendations=select, "移除推荐动态", "移除推荐模块", "关闭", tag=移除-动态页 UP 主的推荐, desc=选择移除包含推荐商品的动态、仅移除推荐商品模块，或关闭
cleanHomeGameButton=switch, true, false, tag=移除-首页右上角的游戏按钮, desc=开启后删除首页右上角消息按钮左侧的游戏中心按钮
dynamicUpListDisplay=select, "始终显示", "仅存在直播时显示", "始终隐藏", tag=个性化-动态页的最常访问, desc=仅存在直播时显示、始终显示、始终隐藏
cleanHomeTopTabs=switch, true, false, tag=个性化-精简 iOS 首页顶部的分区按钮, desc=仅作用于 iOS；开启后首页顶部分区只保留直播、推荐和热门，iPadOS 不使用该过滤代码
cleanBottomExtraButtons=switch, true, false, tag=个性化-删除软件底部的多余按钮, desc=开启后删除底部栏加号和会员购按钮，保留首页、动态、我的等普通入口
cleanMineCreationCenter=switch, true, false, tag=个性化-删除我的页面里的创作中心, desc=开启后删除我的页面里的创作中心模块
cleanMineServices=switch, true, false, tag=个性化-删除我的页面里的我的服务, desc=开启后删除我的页面里的我的服务模块
blockTrackers=switch, true, false, tag=个性化-不允许追踪与数据上报, desc=开启后改写 pd-proxy/tracker 返回的 STUN/追踪服务器为失效地址；biliapi 上报域名与 WebRTC stun 拦截为常开（[Rule]，不受此开关控制）
notifyFilter=switch, false, true, tag=（调试用）插件弹窗通知-屏蔽, desc=开启后显示标题、UP 主和视频 Tag 屏蔽结果
notifyRemove=switch, false, true, tag=（调试用）插件弹窗通知-移除, desc=开启后显示开屏、搜索、动态页和广告清理等移除类结果
notifyPersonalization=switch, false, true, tag=（调试用）插件弹窗通知-个性化, desc=开启后显示个性化配置清理结果，如底部栏多余按钮和我的页面模块
logLevel=select, "warn", "off", "error", "info", "debug", tag=日志等级, desc=脚本日志等级

[Rule]
DOMAIN, api.biliapi.com, REJECT
DOMAIN, app.biliapi.com, REJECT
DOMAIN, api.biliapi.net, REJECT
DOMAIN, app.biliapi.net, REJECT
AND, ((DOMAIN-SUFFIX, chat.bilibili.com), (OR, ((DOMAIN-KEYWORD, stun), (DOMAIN-KEYWORD, tracker)))), REJECT

[Script]
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:show|list|brand\/list|brand\/show|event\/list|event\/list2|ad\/list|topview\/list)\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, enable={cleanSplashAds}, tag=开屏广告移除
http-response ^https:\/\/app\.bilibili\.com\/x\/resource\/(?:show\/tab\/v2|show\/skin|peak\/download)\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, tag=软件启动时推广资源清理
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, tag=我的页面个性化清理
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\/ipad\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, tag=iPadOS 我的页面个性化清理
http-response ^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, enable={cleanStartupAds}, tag=iPadOS 大会员广告素材清理
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square\? script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, tag=首页搜索页面移除
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, binary-body-mode=true, enable={cleanSearchDefaultWords}, tag=搜索框推荐词移除
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/Suggest3$ script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, binary-body-mode=true, tag=搜索候选词条关键词过滤
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ script-path=https://raw.githubusercontent.com/ElyDemiurge/Loon-Plugins/main/bilibili/bilibili_cleaner.js?v=20260726-112, argument=[{blockedUps}, {titleKeywords}, {dynamicKeywords}, {searchResultKeywords}, {deepFilter}, {videoTagKeywords}, {cleanFeedAds}, {cleanFeedPromotedVideos}, {cleanVideoRelatedPromotedContent}, {cleanVideoRelatedAds}, {cleanVideoBannerAds}, {cleanVideoRelatedLiveRecommendations}, {cleanVideoUpGoodsAds}, {cleanSplashAds}, {cleanStartupAds}, {cleanDynamicUpRecommendations}, {cleanSearchTrending}, {cleanSearchHistory}, {cleanSearchDiscovery}, {cleanSearchDefaultWords}, {cleanSearchResultAds}, {cleanSearchResultCreatorPromotions}, {cleanSearchResultLiveRooms}, {cleanSearchResultAggregationCards}, {cleanHomeGameButton}, {cleanHomeTopTabs}, {cleanBottomExtraButtons}, {cleanMineCreationCenter}, {cleanMineServices}, {notifyRemove}, {notifyFilter}, {notifyPersonalization}, {cleanReplyTopAds}, {cleanLiveAds}, {cleanTeenagersMode}, {cleanInteractiveDanmaku}, {blockTrackers}, {dynamicUpListDisplay}, {logLevel}], requires-body=true, binary-body-mode=true, tag=搜索结果关键词与 Tag 过滤
